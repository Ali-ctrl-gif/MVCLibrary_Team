<br />
<a asp-action="Create" class="btn btn-success rounded-pill px-4 py-2">Create</a>
<table class="table">
    <tr>
        <th>Name</th>
        <th>Author</th>
        <th>Year</th>
        <th>Category</th> 
        <th>Action</th>
    </tr>
    @foreach (var item in Model.Where(x => x.IsDeleted == false))
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Author</td>
            <td>@item.Year</td>
            <td>@item.Category.Title</td> 
            <td>
                <a asp-action="Update" asp-route-Id="@item.Id">Update</a>
                <a asp-action="Delete" asp-route-Id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>